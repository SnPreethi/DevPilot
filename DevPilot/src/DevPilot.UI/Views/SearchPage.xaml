<Page
    x:Class="DevPilot.UI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <StackPanel>
            <TextBlock Text="Semantic Search" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Search indexed code with local embeddings." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,96,Auto,Auto" ColumnSpacing="8">
            <TextBox
                PlaceholderText="Ask about the codebase"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <NumberBox Grid.Column="1" Minimum="1" Maximum="25" Value="{Binding MaxResults, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" />
            <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center" />
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding Results}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SymbolName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ChunkType}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Similarity}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding FilePath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{Binding Preview}" FontFamily="Consolas" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
