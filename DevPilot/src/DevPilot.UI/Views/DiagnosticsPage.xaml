<Page
    x:Class="DevPilot.UI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <StackPanel>
            <TextBlock Text="Diagnostics" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Inspect retrieval, prompts, tokens, chunks, and runtime timings." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,96,Auto,Auto" ColumnSpacing="8">
            <TextBox
                PlaceholderText="Diagnostic query"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <NumberBox Grid.Column="1" Minimum="1" Maximum="25" Value="{Binding MaxResults, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="Inspect" Command="{Binding InspectCommand}" />
            <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,*,*" ColumnSpacing="16" RowSpacing="16">
            <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="Runtime" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding Runtime.SelectedProvider}" />
                    <TextBlock Text="{Binding Runtime.ProviderStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Models" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding Runtime.EmbeddingModelStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Runtime.LlmModelStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Runtime.TokenizerStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hardware" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding Runtime.HardwareSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Runtime.MemoryStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Runtime.InferenceTimingStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{Binding RetrievalMatches}">
                <ListView.Header>
                    <TextBlock Text="Retrieval Matches" Style="{ThemeResource SubtitleTextBlockStyle}" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6">
                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Similarity}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Row="1" Grid.Column="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Prompt Preview" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding PromptPreview}" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <ListView Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Chunks}">
                <ListView.Header>
                    <TextBlock Text="Chunk Statistics" Style="{ThemeResource SubtitleTextBlockStyle}" />
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding SymbolName}" />
                            <TextBlock Grid.Column="2" Text="{Binding TokenEstimate}" />
                            <TextBlock Grid.Column="3" Text="{Binding ChunkHash}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" />
            <TextBlock Text="{Binding MetricsSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
        </StackPanel>
    </Grid>
</Page>
