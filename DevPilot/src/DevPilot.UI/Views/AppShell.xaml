<UserControl
    x:Class="DevPilot.UI.Views.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Repositories" Icon="Folder" Tag="Repositories" />
                <NavigationViewItem Content="Search" Icon="Find" Tag="Search" />
                <NavigationViewItem Content="Assistant" Icon="Contact" Tag="Assistant" />
                <NavigationViewItem Content="Diagnostics" Icon="Repair" Tag="Diagnostics" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</UserControl>
