<Page
    x:Class="DevPilot.UI.Views.RepositoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <StackPanel>
            <TextBlock Text="Repositories" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Manage local repositories and incremental indexing." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBox
                PlaceholderText="Repository path"
                Text="{Binding RepositoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Index" Command="{Binding IndexCommand}" />
            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" />
            <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center" />
            </StackPanel>

            <ListView
                Grid.Row="1"
                ItemsSource="{Binding Repositories}"
                SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="2*,3*,Auto,Auto" ColumnSpacing="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RootPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding FileCount}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding ChunkCount}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
