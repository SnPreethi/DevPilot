{
  "Application": {
    "Name": "DevPilot for Windows",
    "Environment": "Production"
  },
  "Storage": {
    "DatabasePath": "data/devpilot.db",
    "CreateIfMissing": true
  },
  "Indexing": {
    "MaxFileSizeInBytes": 1048576,
    "ExcludedDirectories": [
      ".git",
      ".vs",
      ".vscode",
      ".idea",
      "bin",
      "obj",
      "node_modules",
      "dist",
      "build",
      "packages",
      ".venv",
      "venv",
      "env",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      ".next",
      "out",
      "coverage"
    ]
  },
  "Models": {
    "ModelRootPath": "models",
    "LazyLoadModels": true
  },
  "Embeddings": {
    "GenerateDuringIndexing": true,
    "ModelName": "all-MiniLM-L6-v2",
    "ModelPath": "models/embeddings/all-MiniLM-L6-v2/model.onnx",
    "VocabularyPath": "models/embeddings/all-MiniLM-L6-v2/vocab.txt",
    "Dimensions": 384,
    "BatchSize": 16,
    "MaxTokens": 256,
    "AllowDeterministicFallback": true
  },
  "VectorSearch": {
    "DefaultTopK": 5,
    "SimilarityMetric": "cosine",
    "UseSqliteVss": false,
    "SqliteVssExtensionPath": null
  },
  "LLM": {
    "ModelId": "phi-3-mini-4k-instruct",
    "ModelPath": "models/llm/phi-3-mini/model.onnx",
    "TokenizerModelPath": "models/llm/phi-3-mini/tokenizer.model",
    "MaxSequenceLength": 4096,
    "MaxOutputTokens": 512,
    "Temperature": 0.2,
    "TopP": 0.9,
    "StopTokenIds": [
      2,
      32000,
      32007
    ],
    "AllowExtractiveFallback": true,
    "EnableTokenLogging": true,
    "EnableTensorLogging": false,
    "EnableStreamingLogging": true
  },
  "Inference": {
    "MaxSequenceLength": 4096,
    "MaxGenerationTokens": 512,
    "GreedyDecoding": true
  },
  "Tokenizer": {
    "EmbeddingMaxTokens": 256,
    "LlmMaxTokens": 4096,
    "EnableTruncation": true
  },
  "Streaming": {
    "Enabled": true,
    "CancellationProbeTokens": 2
  },
  "ExecutionProviders": {
    "PreferredProvider": "CPU",
    "FallbackProvider": "CPU",
    "AllowFallback": true
  },
  "RAG": {
    "RetrievalCount": 5,
    "MaxContextChunks": 5
  },
  "Prompting": {
    "MaxPromptCharacters": 12000,
    "MaxChunkCharacters": 2000
  },
  "Diagnostics": {
    "EnableRetrievalDiagnostics": true,
    "IncludePromptPreview": true,
    "DefaultInspectionLimit": 25
  },
  "IncrementalIndexing": {
    "Enabled": true,
    "RemoveDeletedFiles": true,
    "SkipUnchangedFiles": true
  },
  "Performance": {
    "LogSummaries": true,
    "LogOperationTimings": true
  },
  "EmbeddingVersioning": {
    "EmbeddingModelVersion": "all-MiniLM-L6-v2@1",
    "EmbeddingSchemaVersion": 1,
    "ReembedStaleEmbeddings": true
  },
  "TokenEstimation": {
    "CharactersPerToken": 4,
    "MinimumTokens": 1
  },
  "RuntimeOptimization": {
    "PreferredExecutionProviders": [
      "DirectML",
      "CPU"
    ],
    "AllowProviderFallback": true,
    "EnableMemoryPattern": true,
    "EnableCpuMemoryArena": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}